// Prisma schema for Dynamic MCQ Learning Platform
// Portable to PostgreSQL by changing `provider = "postgresql"` and the connection URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("user") // "user" | "admin"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Personalized academic profile
  currentClassId     String?  // the student's current class
  onboardingCompleted Boolean @default(false)
  currentClass       Class?   @relation("UserCurrentClass", fields: [currentClassId], references: [id], onDelete: SetNull)
  selectedSubjects   UserSubject[]

  attempts      QuizAttempt[]
  answers       UserAnswer[]
  flags         QuestionFlag[]
  mastery       QuestionMastery[]
  aiExplanations AIExplanation[]
  announcements  Announcement[] @relation("AnnouncementAdmin")
  imports       ImportHistory[] @relation("ImportAdmin")
  activities    AdminActivity[] @relation("ActivityAdmin")
}

// ---------------------------------------------------------------------------
// Student-Subject selection (personalized academic profile)
// ---------------------------------------------------------------------------
model UserSubject {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

// ---------------------------------------------------------------------------
// Academic hierarchy (fully dynamic, no hardcoded content)
// ---------------------------------------------------------------------------
model Class {
  id            String    @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  subjects      Subject[]
  quizSets      QuizSet[]
  users         User[]    @relation("UserCurrentClass")
}

model Subject {
  id            String    @id @default(cuid())
  classId       String
  name          String
  description   String?
  icon          String? // lucide icon name, optional
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  topics        Topic[]
  quizSets      QuizSet[]
  attempts      QuizAttempt[]
  userSelections UserSubject[]
}

model Topic {
  id            String    @id @default(cuid())
  subjectId     String
  name          String
  description   String?
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?
  contentType   String    @default("curriculum") // "curriculum" | "extra_practice"

  subject       Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      QuizAttempt[]
}

// ---------------------------------------------------------------------------
// Questions
// ---------------------------------------------------------------------------
model Question {
  id             String    @id @default(cuid())
  topicId        String
  questionText   String
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctOption  String    // "A" | "B" | "C" | "D"
  explanation    String?
  status         String    @default("draft") // "draft" | "published"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  // Content classification: "curriculum" (My Learning) or "extra_practice" (Extra Practice/Explore)
  contentType    String    @default("curriculum")

  // Optional images
  questionImage  String?
  optionAImage   String?
  optionBImage   String?
  optionCImage   String?
  optionDImage   String?

  // External source metadata (only set for imported/external questions)
  sourceType     String?   // "dataset" | "api" | "manual"
  sourceName     String?   // e.g. "ScienceQA"
  sourceQuestionId String? // original ID from the source
  sourceLicense  String?   // license info if required
  suitableLevels String?   // JSON array of class IDs, e.g. "[\"class-9-id\",\"class-10-id\"]"

  // Optional batch identifier grouping questions from the same import run
  // (e.g. "nepal-2026-10-10-001"). Used by Import Center to filter by batch.
  importBatchId  String?

  topic          Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  quizSetLinks   QuizSetQuestion[]
  answers        UserAnswer[]
  flags          QuestionFlag[]
  mastery        QuestionMastery[]
  aiExplanations AIExplanation[]

  // Indexes for admin filtering and student quiz queries.
  @@index([status])
  @@index([topicId])
  @@index([contentType])
  @@index([status, contentType])
  @@index([sourceType, sourceQuestionId])
  @@index([sourceName])
  @@index([importBatchId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Quiz Sets (optional grouping)
// ---------------------------------------------------------------------------
model QuizSet {
  id            String    @id @default(cuid())
  name          String
  classId       String
  subjectId     String?
  description   String?
  status        String    @default("draft") // "draft" | "published"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?
  // Random set mode: when mode is "random", the quiz uses N random
  // published questions from the topic instead of fixed selections.
  mode          String    @default("fixed") // "fixed" | "random"
  randomCount   Int?      // number of questions for random mode

  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject       Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions     QuizSetQuestion[]
  attempts      QuizAttempt[]
}

model QuizSetQuestion {
  id           String   @id @default(cuid())
  quizSetId    String
  questionId   String

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizSet      QuizSet  @relation(fields: [quizSetId], references: [id], onDelete: Cascade)

  @@unique([quizSetId, questionId])
}

// ---------------------------------------------------------------------------
// Quiz attempts & history
// ---------------------------------------------------------------------------
model QuizAttempt {
  id                String    @id @default(cuid())
  userId            String
  topicId           String?
  subjectId         String?   // set for subject-level exams (pulls from all topics)
  quizSetId         String?
  totalQuestions    Int
  correctAnswers    Int       @default(0)
  scorePercentage   Float     @default(0)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic             Topic?    @relation(fields: [topicId], references: [id])
  subject           Subject?  @relation(fields: [subjectId], references: [id])
  quizSet           QuizSet?  @relation(fields: [quizSetId], references: [id])
  answers           UserAnswer[]
}

model UserAnswer {
  id              String    @id @default(cuid())
  attemptId       String
  userId          String
  questionId      String
  selectedOption  String    // "A".."D"
  isCorrect       Boolean
  answeredAt      DateTime  @default(now())

  attempt         QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [questionId], references: [id])
}

// ---------------------------------------------------------------------------
// Settings (key/value store; values are JSON-encoded strings)
// ---------------------------------------------------------------------------
model Setting {
  id     String @id @default(cuid())
  key    String @unique
  value  String // JSON-encoded, e.g. "[10,20,30,40,50]"
}

// ---------------------------------------------------------------------------
// Question Flags (student bookmarks a question for later review)
// ---------------------------------------------------------------------------
model QuestionFlag {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  note        String?  // optional student note
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId]) // one flag per user per question
}

// ---------------------------------------------------------------------------
// Question Mastery (spaced-repetition tracking)
// ---------------------------------------------------------------------------
model QuestionMastery {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  timesSeen      Int      @default(0)
  timesCorrect   Int      @default(0)
  currentStreak  Int      @default(0)
  // SM-2-inspired ease factor (1.3–2.5). Higher = longer interval.
  easeFactor     Float    @default(2.5)
  // Days until this question should be shown again. 0 = due now.
  intervalDays   Int      @default(0)
  lastSeenAt     DateTime?
  nextDueAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

// ---------------------------------------------------------------------------
// AI Explanations (cached LLM-generated explanations for wrong answers)
// ---------------------------------------------------------------------------
model AIExplanation {
  id           String   @id @default(cuid())
  questionId   String
  userId       String?  // null = shared cache for all users
  explanation  String
  createdAt    DateTime @default(now())

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

// ---------------------------------------------------------------------------
// Announcements (admin-published notices shown to students)
// ---------------------------------------------------------------------------
model Announcement {
  id            String    @id @default(cuid())
  title         String
  message       String
  status        String    @default("draft") // "draft" | "published"
  publishDate   DateTime  @default(now())
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  // Admin who created it (optional — the admin who created the announcement).
  adminId       String?
  admin         User?     @relation("AnnouncementAdmin", fields: [adminId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Import History (tracks JSON question imports)
// ---------------------------------------------------------------------------
model ImportHistory {
  id            String   @id @default(cuid())
  filename      String
  className     String
  subjectName   String
  topicName     String
  imported      Int      @default(0)
  failed        Int      @default(0)
  skipped       Int      @default(0)
  imagesCount   Int      @default(0)
  adminId       String?
  createdAt      DateTime @default(now())

  admin          User?    @relation("ImportAdmin", fields: [adminId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Admin Activity Log (tracks important admin actions)
// ---------------------------------------------------------------------------
model AdminActivity {
  id            String   @id @default(cuid())
  adminId       String?
  action        String   // e.g. "question.created", "question.published", "topic.archived"
  entity        String   // e.g. "Question", "Topic", "Class"
  entityId      String?
  description   String   // human-readable: "Published 13 Force & Motion questions"
  createdAt     DateTime @default(now())

  admin         User?    @relation("ActivityAdmin", fields: [adminId], references: [id], onDelete: SetNull)
}
